PORT=5000
JWT_SECRET=<put a long random string here>
JWT_EXPIRES_IN=7d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_diary
DB_USER=postgres
DB_PASSWORD=<your postgres password>
CORS_ORIGIN=http://localhost:5000
APP_URL=http://localhost:5000
# Resend creds for account-verification emails — https://resend.com/api-keys
RESEND_API_KEY=<your resend api key, starts with re_>
RESEND_FROM=<from address shown to users, e.g. Personal Diary <onboarding@yourdomain.com>>
# RESEND_FROM must be on a domain you've verified in Resend (or use their onboarding@resend.dev sandbox for testing).